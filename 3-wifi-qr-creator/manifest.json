{
  "manifest_version": 3,
  "name": "WiFi QR Code Creator",
  "version": "1.0.0",
  "description": "Create instant WiFi QR codes to share your home or office network with guests without revealing passwords.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "WiFi QR Code Creator"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wifi-qr-creator@craftrex.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
